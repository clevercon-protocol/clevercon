{
  "name": "@clevercon/mcp",
  "version": "0.4.0",
  "description": "Stellar MCP server: give an AI agent a bounded, non-custodial spending account (pay, disburse, hire, set limits, read budget and activity)",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "clevercon-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npx tsx src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/server.js",
    "test": "node test-server.mjs"
  },
  "dependencies": {
    "@clevercon/agent-sdk": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/stellar-sdk": "^14.6.1",
    "dotenv": "^16.4.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0"
  }
}
