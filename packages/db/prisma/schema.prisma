// CleverCon data model.
//
// Postgres is the queryable, reconciled MIRROR of on-chain state; the chain
// (CleverVault / policy-verifier / registry) remains the source of truth for
// money. Amounts are stored as Decimal(20,7) in USDC units (7 dp = stroops
// precision). Conversions to/from on-chain stroops happen at the edges.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity & auth ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Public provider profile (so a service can show WHO listed it). All optional;
  // a provider who never sets these shows a shortened wallet as a fallback.
  displayName String? // shown as the owner name
  handle      String? @unique // URL-safe id for the public profile page (/p/:handle)
  bio         String?
  links       Json? // { website, docs, github, x, ... }
  verified    Boolean   @default(false) // admin-granted; all this user's services inherit the tick
  verifiedAt  DateTime?

  wallets        Wallet[]
  roles          UserRole[]
  sessions       Session[]
  apiKeys        ApiKey[]
  tasks          Task[]               @relation("BuyerTasks")
  services       Service[]            @relation("ProviderServices")
  policies       Policy[]
  webhooks       Webhook[]
  auditLogs      AuditLog[]
  delegate       AgentDelegate?
  agentWallet    AgentWallet?
  orgsCreated    Organization[]       @relation("OrgCreator")
  orgMemberships OrganizationMember[] @relation("OrgMemberships")

  @@map("users")
}

// An organization that can own/list services (e.g. CleverCon). A service owned by an
// org shows the org as its provider; the org's verified tick (admin-granted) carries
// to every service it lists. Members are the users allowed to list under it.
model Organization {
  id          String               @id @default(cuid())
  handle      String               @unique // URL-safe id for /p/:handle
  name        String
  bio         String?
  links       Json? // { website, docs, github, x, support, discord }
  verified    Boolean              @default(false)
  verifiedAt  DateTime?
  createdById String
  createdBy   User                 @relation("OrgCreator", fields: [createdById], references: [id])
  members     OrganizationMember[]
  services    Service[]            @relation("OrgServices")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  orgId  String
  userId String
  role   String @default("admin") // admin | member (admins can list + edit the org)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation("OrgMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// The per-user spending delegate (orchestrator) the platform provisions and the
/// user authorizes on the vault. The secret is stored encrypted at rest (AES-GCM;
/// KMS in production). Bounded by the vault policy, so even if leaked it cannot
/// overspend; holds only a little XLM for fees, never user funds.
model AgentDelegate {
  userId       String   @id
  publicKey    String   @unique // the Stellar G... address the user registers
  secretCipher String // AES-256-GCM ciphertext of the secret key (base64 iv:tag:data)
  registered   Boolean  @default(false) // whether register_orchestrator has been confirmed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_delegates")
}

/// The user's OWN agent key (for the agent-key payment mode: paying external
/// x402/MPP services). The platform stores ONLY the public key and NEVER the
/// secret, so it is non-custodial by construction: the vault tops this address
/// up in bounded amounts under the user's policy, and the user's agent signs
/// its own payments. Distinct from AgentDelegate (a platform-held authorizer
/// that never holds funds).
model AgentWallet {
  userId    String   @id
  publicKey String   @unique // the agent's Stellar G... address; secret held by the user, not us
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_wallets")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique // Stellar G... address
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

enum Role {
  BUYER
  PROVIDER
  ADMIN
  DEVELOPER
}

model UserRole {
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

// Short-lived nonce for wallet sign-in (SEP-10-style challenge/response).
model AuthChallenge {
  id         String    @id @default(cuid())
  address    String
  nonce      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([address])
  @@map("auth_challenges")
}

// Refresh-token-backed session (access JWTs are stateless).
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Programmatic access for developers (SDK/MCP). Hashed at rest, scoped.
model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  name         String
  prefix       String    @unique // shown to the user; the rest is secret
  keyHash      String
  scopes       String[]  @default([])
  lastUsedAt   DateTime?
  requestCount Int       @default(0) // lifetime authenticated calls (usage metering)
  quotaPerDay  Int       @default(0) // max calls per UTC day; 0 = unlimited
  usageDay     String? // current quota window, YYYY-MM-DD (UTC)
  usageToday   Int       @default(0) // calls in the current window
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// ── Vault (on-chain mirror) ──────────────────────────────────────────────────

model VaultAccount {
  id             String   @id @default(cuid())
  address        String // Stellar G... address (may or may not map to a User)
  asset          String // asset contract id (e.g. USDC SAC)
  balance        Decimal  @default(0) @db.Decimal(20, 7)
  locked         Decimal  @default(0) @db.Decimal(20, 7)
  totalDeposited Decimal  @default(0) @db.Decimal(20, 7)
  totalSpent     Decimal  @default(0) @db.Decimal(20, 7)
  activeTasks    Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([address, asset])
  @@map("vault_accounts")
}

// ── Marketplace / providers ──────────────────────────────────────────────────

enum ServiceStatus {
  ACTIVE
  INACTIVE
  NEW
}

enum PricingModel {
  X402
  MPP
}

model Service {
  id              String        @id @default(cuid())
  providerId      String? // the User (provider) who registered it, if registered here
  ownerOrgId      String? // when listed under an organization (else the provider is the owner)
  agentId         String        @unique // registry agent_id
  name            String
  description     String
  category        String?
  capabilities    String[]      @default([])
  pricingModel    PricingModel
  pricePerCall    Decimal       @db.Decimal(20, 7)
  currency        String        @default("USDC")
  endpoint        String
  stellarAddress  String
  healthCheck     String?
  manifestHash    String? // hash mirrored from the on-chain registry
  status          ServiceStatus @default(NEW)
  // Acceptance contract (marketplace economy). See .local/MARKETPLACE-ECONOMY-SPEC.md.
  tier            String        @default("T2") // T1 verifiable | T2 attestable | T3 subjective
  inputSchema     Json? // JSON Schema for the request input
  outputSchema    Json? // JSON Schema for the result
  verification    Json? // { method, spec } for how delivery is judged
  bondAmount      Decimal       @default(0) @db.Decimal(20, 7) // optional slashable stake (phased)
  manifestVersion Int           @default(1) // bumped on edits; anti bait-and-switch
  // Interaction/payment shape (marketplace v2). Absent = sync/escrow (back-compat).
  interaction     String? // sync | async | human | metered
  paymentModel    String? // escrow | x402 | mpp-session | subscription
  attachmentsIn   Json? // AttachmentSpec {required,accept,maxSizeBytes,maxCount} for required input files
  // Requirement CATALOG: every usage requirement any function may need (not given in
  // the prompt): an authorization/OAuth, an install, an API key/credential, or info.
  // Prerequisite[]: { kind, key, label, instructions, url?, secret? }. A function
  // references these by key; the buyer is gated PER FUNCTION, not for the whole service.
  prerequisites   Json?
  // Callable functions. A single-function service may omit this (the top-level
  // io/pricing/tier describe its one operation); a multi-function service lists each
  // with its own input/output, required requirement keys, and pricing. ServiceFunction[].
  functions       Json?
  // Public contact/identity links { website, docs, support, github, x, discord }.
  contactLinks    Json?
  registeredAt    DateTime      @default(now())
  lastSeen        DateTime?
  // System-managed health (a periodic worker pings the endpoint's /health). This is
  // AUTO-RECOVERING and distinct from the provider-controlled `status`: an unhealthy
  // service drops out of the public directory but flips back to healthy on its own
  // when the endpoint recovers, so a transient blip never requires manual action.
  healthy         Boolean       @default(true)
  lastHealthyAt   DateTime?
  healthFailures  Int           @default(0) // consecutive failed checks
  updatedAt       DateTime      @updatedAt

  provider   User?              @relation("ProviderServices", fields: [providerId], references: [id])
  ownerOrg   Organization?      @relation("OrgServices", fields: [ownerOrgId], references: [id])
  reputation ServiceReputation?
  steps      TaskStep[]
  bonds      ServiceBond[]

  @@index([providerId])
  @@index([ownerOrgId])
  @@index([category])
  @@map("services")
}

// A buyer's satisfied usage requirements for one service (see Service.prerequisites).
// One row per (user, service). `data` holds non-secret values { key: value } and a
// marker for install/oauth the user confirmed; `secretCipher` holds the encrypted JSON
// of secret values (apiKey/token), passed to the provider at job time, never to the LLM.
model ServiceSetup {
  id           String   @id @default(cuid())
  userId       String
  serviceId    String
  data         Json     @default("{}")
  secretCipher String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, serviceId])
  @@index([userId])
  @@map("service_setups")
}

model ServiceReputation {
  serviceId      String    @id
  score          Float     @default(0)
  totalJobs      Int       @default(0)
  successfulJobs Int       @default(0)
  failedJobs     Int       @default(0)
  avgQuality     Float     @default(0)
  avgLatencyMs   Int       @default(0)
  // Marketplace trust signals: distinct paying counterparties (anti-self-dealing),
  // recency, and dispute history. See MARKETPLACE-ECONOMY-SPEC.md sections 6-7.
  uniquePayers   Int       @default(0)
  lastSettled    DateTime?
  disputes       Int       @default(0)
  disputesUpheld Int       @default(0)
  lastUpdated    DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_reputation")
}

// A provider's optional slashable stake (phased, P3). Unused until bonds ship;
// defined now so the relation exists. See MARKETPLACE-ECONOMY-SPEC.md section 7.
model ServiceBond {
  id         String   @id @default(cuid())
  serviceId  String
  amount     Decimal  @db.Decimal(20, 7)
  status     String   @default("ACTIVE") // ACTIVE | SLASHED | WITHDRAWN
  lockTxHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_bonds")
}

// ── Tasks & execution ────────────────────────────────────────────────────────

enum TaskMode {
  DIRECT // pay a chosen provider
  SEARCH // find and pay one service
  COMPOSE // multi-service job
  PAY // direct payment to one address (no provider execution)
  DISBURSE // direct payments to many addresses (no provider execution)
}

enum TaskStatus {
  DRAFT
  PENDING
  RUNNING
  COMPLETED
  CANCELLED
  DISPUTED
  FAILED
}

enum StepStatus {
  PENDING
  RUNNING
  INPUT_REQUIRED
  AWAITING_APPROVAL
  RELEASED
  FAILED
  SKIPPED
}

model Task {
  id               String     @id @default(cuid())
  buyerId          String
  title            String
  description      String?
  mode             TaskMode
  budget           Decimal    @db.Decimal(20, 7)
  asset            String
  status           TaskStatus @default(DRAFT)
  vaultTaskId      BigInt? // on-chain task id once locked
  vaultFinalizedAt DateTime? // set once complete_task finalized the on-chain task (unlocks remainder)
  policyId         String?
  // Client-supplied Idempotency-Key: a retried spend request with the same key
  // returns the original task instead of creating a duplicate. NULLs are distinct
  // in Postgres, so keyless requests never collide.
  idempotencyKey   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  buyer    User       @relation("BuyerTasks", fields: [buyerId], references: [id])
  policy   Policy?    @relation(fields: [policyId], references: [id])
  steps    TaskStep[]
  payments Payment[]
  disputes Dispute[]

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId])
  @@index([status])
  @@map("tasks")
}

model TaskStep {
  id            String     @id @default(cuid())
  taskId        String
  index         Int
  serviceId     String?
  payee         String? // direct recipient for PAY/DISBURSE steps (no provider)
  action        String
  functionKey   String? // which ServiceFunction this hire invokes (the dispatched action)
  input         Json? // structured job input (validated against the service's inputSchema)
  dependsOn     Int[]      @default([])
  estimatedCost Decimal    @db.Decimal(20, 7)
  status        StepStatus @default(PENDING)
  output        String?
  error         String?
  qualityRating Float? // advisory LLM-judge score (0-5) of the delivery vs the service rubric
  qualityNote   String? // one-line rationale from the judge (advisory; never gates payment)
  artifact      Json? // ArtifactRef {url, hash, contentType, size} when the provider returns a file
  latencyMs     Int?
  // Async / needs-input execution state (marketplace v2). See service-manifest.ts.
  providerJobHandle String? // durable handle the worker polls for an async (status=working) job
  progress          Json? // { pct?, message? } last progress a working async job reported
  inputRequest      Json? // InputRequest the provider asked mid-job (set with status INPUT_REQUIRED)
  inputResponse     Json? // the answer supplied for inputRequest; resumes the job on the next poll
  releaseAt     DateTime? // T2 dispute window: when a held step auto-releases if undisputed
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id])
  payments Payment[]

  @@unique([taskId, index])
  @@index([taskId])
  @@map("task_steps")
}

// ── Payments & settlement ────────────────────────────────────────────────────

enum PaymentMethod {
  X402
  MPP
  VAULT_RELEASE
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model Payment {
  id             String        @id @default(cuid())
  taskId         String?
  stepId         String?
  fromAddress    String
  toAddress      String
  asset          String
  amount         Decimal       @db.Decimal(20, 7)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  txHash         String?
  idempotencyKey String        @unique // prevents double-spend on retries
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  task       Task?       @relation(fields: [taskId], references: [id])
  step       TaskStep?   @relation(fields: [stepId], references: [id])
  settlement Settlement?

  @@index([taskId])
  @@index([txHash])
  @@map("payments")
}

model Settlement {
  id         String   @id @default(cuid())
  paymentId  String   @unique
  reconciled Boolean  @default(false)
  ledger     BigInt?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("settlements")
}

// ── Privacy (policies & proofs) ──────────────────────────────────────────────

model Policy {
  id              String   @id @default(cuid())
  userId          String
  commitment      String // 32-byte commitment hash (hex)
  isPrivate       Boolean  @default(true)
  // Plaintext rule is NOT stored server-side unless the user explicitly opts in.
  ruleSummary     Json?
  // Private rules: a wallet-encrypted backup of {clauses, salt} (ciphertext only;
  // key derived from a wallet signature) so the owner can re-prove across devices
  // and re-view the salt. The server cannot read it. Null for public rules.
  encryptedBackup String?
  // Soft marketplace eligibility (service allow/deny, allowed tiers): NON-sensitive
  // curation the app enforces at hire, stored in cleartext in BOTH lanes (the
  // sensitive spend clauses stay private/committed). The on-chain payee allowlist is
  // the hard backstop; this is the convenience filter. { allowedTiers?, serviceAllow?,
  // serviceDeny? }.
  eligibility     Json?
  // Lifecycle + shared rule-model fields (Phase A5). All additive/defaulted so
  // Railway's db:deploy syncs them with no data loss.
  name            String?
  form            String   @default("private") // "private" | "public" (the lane)
  status          String   @default("active") //  "active" | "archived"
  version         Int      @default(1)
  supersedes      String? //  id of the policy this version replaces (edit lineage)
  global          Boolean  @default(false) //    flagged as the account global for its lane
  createdAt       DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
  proofs Proof[]

  @@index([userId])
  @@map("policies")
}

enum ProofStatus {
  REQUESTED
  GENERATING
  READY
  VERIFIED
  REJECTED
  FAILED
}

model Proof {
  id        String      @id @default(cuid())
  policyId  String?
  taskId    String?
  stepId    String?
  status    ProofStatus @default(REQUESTED)
  nullifier String?     @unique
  proofRef  String? // storage reference to the proof blob
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  policy Policy? @relation(fields: [policyId], references: [id])

  @@index([taskId])
  @@map("proofs")
}

// ── Disputes ─────────────────────────────────────────────────────────────────

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

model Dispute {
  id               String        @id @default(cuid())
  taskId           String
  raisedBy         String // wallet address
  status           DisputeStatus @default(OPEN)
  reason           String?
  resolution       String?
  refundToUser     Decimal?      @db.Decimal(20, 7)
  payoutToProvider Decimal?      @db.Decimal(20, 7)
  judgeVerdict     Json? // LLM-judge output recorded during the dispute window
  tier             String? // snapshot of the service's tier at dispute time
  providerResponse String? // the provider's reply/evidence to the dispute
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
  @@map("disputes")
}

// ── Chain indexer ────────────────────────────────────────────────────────────

model ChainEvent {
  id         String   @id @default(cuid())
  contractId String
  type       String
  ledger     BigInt
  txHash     String
  cursor     String   @unique // dedupe + resume point
  payload    Json
  createdAt  DateTime @default(now())

  @@index([contractId, type])
  @@index([ledger])
  @@map("chain_events")
}

// Resume state for the event indexer (one row per logical stream).
model IndexerState {
  key       String   @id
  cursor    String?
  updatedAt DateTime @updatedAt

  @@map("indexer_state")
}

// ── Webhooks & audit ─────────────────────────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  events    String[] @default([])
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhooks")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
