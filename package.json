{
  "name": "clevercon",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build:dashboard": "cd packages/dashboard && ../../node_modules/.bin/vite build",
    "build:web": "cd apps/web && ../../node_modules/.bin/tsc --noEmit && ../../node_modules/.bin/vite build",
    "bootstrap": "npx tsx scripts/bootstrap.ts",
    "setup-wallets": "npx tsx scripts/setup-wallets.ts",
    "fund-testnet-usdc": "npx tsx scripts/fund-testnet-usdc.ts",
    "add-usdc-trustlines": "npx tsx scripts/add-usdc-trustlines.ts",
    "distribute-usdc": "npx tsx scripts/distribute-usdc.ts",
    "build": "npm run build:dashboard && npm run build:web",
    "typecheck": "bash scripts/typecheck.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:build": "tsc -p packages/db/tsconfig.json",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "setup": "cp -n .env.example .env || true && (npm run db:up || echo 'Docker unavailable — using an existing local Postgres (set DATABASE_URL in .env)') && npm run db:generate && npm run db:push && npm run db:seed",
    "postinstall": "npm run db:generate && npm run db:build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
